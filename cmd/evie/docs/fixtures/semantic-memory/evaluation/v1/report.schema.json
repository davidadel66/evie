{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidadel66/evie/blob/master/cmd/evie/docs/fixtures/semantic-memory/evaluation/v1/report.schema.json",
  "title": "Evie memory evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_schema_version", "run", "fixture", "environment", "components", "fixture_cardinality", "baseline_run_id", "panels", "cases", "metrics", "failure_taxonomy", "summary"],
  "properties": {
    "report_schema_version": {"const": 1},
    "run": {"$ref": "#/$defs/run"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "environment": {"$ref": "#/$defs/environment"},
    "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/component"}},
    "fixture_cardinality": {"$ref":"#/$defs/cardinality"},
    "baseline_run_id": {"type": "string"},
    "panels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/panel"}, {"properties": {"panel": {"const": "semantic_conformance"}}}]},
        {"allOf": [{"$ref": "#/$defs/panel"}, {"properties": {"panel": {"const": "learned_extraction"}}}]},
        {"allOf": [{"$ref": "#/$defs/panel"}, {"properties": {"panel": {"const": "retrieval_provenance"}}}]},
        {"allOf": [{"$ref": "#/$defs/panel"}, {"properties": {"panel": {"const": "answer_abstention"}}}]}
      ]
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "failure_taxonomy": {"type": "array", "items": {"$ref":"#/$defs/failureCount"}},
    "summary": {"$ref":"#/$defs/summary"}
  },
  "$defs": {
    "taxonomy":{"enum":["operation_outcome","scope_revision","replay_divergence","idempotence","scope_leakage","stale_lifecycle_state","temporal_boundary_error","missing_or_wrong_provenance","query_equivalence","restart","recovery"]},
    "run": {"type": "object", "additionalProperties":false,"required": ["id", "commit", "started_at"], "properties": {"id": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "format": "date-time"}}},
    "fixture": {"type": "object", "additionalProperties":false,"required": ["manifest_version", "fixture_version", "dataset_sha256"], "properties": {"manifest_version": {"type": "integer", "minimum": 1}, "fixture_version": {"type": "string", "minLength": 1}, "dataset_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "environment": {"type": "object", "additionalProperties":false,"required": ["hardware", "os", "go_version", "sqlite_version", "journal_mode", "journal_settings", "repetitions", "conditions"], "properties": {"hardware": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "go_version": {"type": "string", "minLength": 1}, "sqlite_version": {"type": "string", "minLength": 1}, "journal_mode": {"type": "string", "minLength": 1}, "journal_settings": {"type": "string", "minLength": 1}, "repetitions": {"type": "integer", "minimum": 1}, "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "component": {"type": "object", "additionalProperties":false,"required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "revision": {"type": "string"}, "config_hash": {"type": "string"}}},
    "cardinality":{"type":"object","additionalProperties":false,"required":["cases","sources","operations","entities","claims","links"],"properties":{"cases":{"type":"integer","minimum":0},"sources":{"type":"integer","minimum":0},"operations":{"type":"integer","minimum":0},"entities":{"type":"integer","minimum":0},"claims":{"type":"integer","minimum":0},"links":{"type":"integer","minimum":0}}},
    "panel": {"type": "object", "additionalProperties":false,"required": ["panel", "status", "case_count", "passed", "failed", "errors", "skipped"], "properties": {"panel":{"enum":["semantic_conformance","learned_extraction","retrieval_provenance","answer_abstention"]},"status": {"enum": ["passed", "failed", "error", "skipped", "not_populated"]}, "case_count": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}},
    "failure":{"type":"object","additionalProperties":false,"required":["taxonomy","message"],"properties":{"taxonomy":{"$ref":"#/$defs/taxonomy"},"message":{"type":"string","minLength":1}}},
    "case": {"type": "object", "additionalProperties":false,"required": ["id", "panel", "release_gate", "status", "duration_ns"], "properties": {"id": {"type": "string", "minLength": 1}, "panel": {"enum": ["semantic_conformance", "learned_extraction", "retrieval_provenance", "answer_abstention"]}, "release_gate": {"type": "boolean"}, "status": {"enum": ["passed", "failed", "error", "skipped"]}, "duration_ns": {"type": "integer", "minimum": 0}, "details": {"type": "object"}, "failure": {"$ref":"#/$defs/failure"}}},
    "values": {"type": "object", "additionalProperties":false,"required": ["p50", "p95", "max"], "properties": {"p50": {"type": "number"}, "p95": {"type": "number"}, "max": {"type": "number"}}},
    "metric": {"type": "object", "additionalProperties":false,"required": ["name", "unit", "condition", "repetitions", "current"], "properties": {"name": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "condition": {"type": "string", "minLength": 1}, "repetitions": {"type": "integer", "minimum": 1}, "current": {"$ref": "#/$defs/values"}, "baseline": {"$ref": "#/$defs/values"}, "delta": {"$ref": "#/$defs/values"}, "threshold": {"type": "number"}}},
    "failureCount":{"type":"object","additionalProperties":false,"required":["taxonomy","count"],"properties":{"taxonomy":{"$ref":"#/$defs/taxonomy"},"count":{"type":"integer","minimum":1}}},
    "summary":{"type":"object","additionalProperties":false,"required":["passed","failed","errors","skipped","release_gate_passed"],"properties":{"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"errors":{"type":"integer","minimum":0},"skipped":{"type":"integer","minimum":0},"release_gate_passed":{"type":"boolean"}}}
  }
}
