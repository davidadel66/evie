root ::= "{" space candidates-kv "," space window-id-kv "}" space
candidates-kv ::= "\"candidates\"" space ":" space candidates
candidates ::= "[" space (candidates-item ("," space candidates-item){0,7})? "]" space
candidates-item-sources-kv ::= "\"sources\"" space ":" space candidates-item-sources
candidates-item-identity ::= ("\"resolved\"" | "\"unresolved\"") space
candidates-item ::= "{" space candidates-item-context-kv "," space candidates-item-effect-kv "," space candidates-item-identity-kv "," space candidates-item-kind-kv "," space candidates-item-object-kv "," space candidates-item-object-kind-kv "," space candidates-item-polarity-kv "," space candidates-item-predicate-kv "," space candidates-item-sources-kv "," space candidates-item-subject-entity-ref-kv "," space candidates-item-subject-name-kv "," space candidates-item-subject-type-kv "," space candidates-item-temporal-kv "}" space
candidates-item-subject-type-kv ::= "\"subject_type\"" space ":" space candidates-item-subject-type
candidates-item-subject-name-kv ::= "\"subject_name\"" space ":" space string
candidates-item-context ::= "[]" space
candidates-item-subject-entity-ref-kv ::= "\"subject_entity_ref\"" space ":" space string
candidates-item-kind-kv ::= "\"kind\"" space ":" space candidates-item-kind
candidates-item-sources-item-2-start-kv ::= "\"start\"" space ":" space candidates-item-sources-item-2-start
candidates-item-temporal-kv ::= "\"temporal\"" space ":" space string
candidates-item-identity-kv ::= "\"identity\"" space ":" space candidates-item-identity
candidates-item-sources-item-2-start ::= ([0] | [1-9] [0-9]{0,15}) space
candidates-item-sources-item-2-ref-kv ::= "\"ref\"" space ":" space candidates-item-sources-item-2-ref
candidates-item-sources-item-2 ::= "{" space candidates-item-sources-item-2-end-kv "," space candidates-item-sources-item-2-ref-kv "," space candidates-item-sources-item-2-selector-kv "," space candidates-item-sources-item-2-start-kv "}" space
candidates-item-object-kind-kv ::= "\"object_kind\"" space ":" space candidates-item-object-kind
candidates-item-sources-item-0-ref ::= ("\"s1\"" | "\"s2\"") space
candidates-item-subject-type ::= ("\"owner\"" | "\"project\"" | "\"new_entity\"" | "\"accepted_entity\"") space
candidates-item-sources-item-2-ref ::= ("\"s1\"" | "\"s2\"") space
candidates-item-sources-item-1 ::= "{" space candidates-item-sources-item-1-ref-kv "," space candidates-item-sources-item-1-selector-kv "}" space
candidates-item-sources ::= "[" space candidates-item-sources-item ("," space candidates-item-sources-item){0,7} "]" space
candidates-item-sources-item-2-selector ::= ("\"range\"") space
candidates-item-sources-item-1-selector ::= ("\"whole\"" | "\"date\"") space
candidates-item-effect-kv ::= "\"effect\"" space ":" space candidates-item-effect
candidates-item-sources-item-0-ref-kv ::= "\"ref\"" space ":" space candidates-item-sources-item-0-ref
candidates-item-sources-item-2-end ::= ([1-9] [0-9]{0,15}) space
candidates-item-object-kv ::= "\"object\"" space ":" space string
candidates-item-predicate-kv ::= "\"predicate\"" space ":" space candidates-item-predicate
candidates-item-sources-item-1-ref ::= ("\"s1\"" | "\"s2\"") space
candidates-item-polarity-kv ::= "\"polarity\"" space ":" space candidates-item-polarity
candidates-item-sources-item-1-ref-kv ::= "\"ref\"" space ":" space candidates-item-sources-item-1-ref
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
candidates-item-predicate ::= ("\"preference\"" | "\"habit\"" | "\"relationship\"" | "\"residence\"" | "\"decision\"" | "\"constraint\"" | "\"employment\"" | "\"consideration\"" | "\"intention\"") space
candidates-item-sources-item-2-end-kv ::= "\"end\"" space ":" space candidates-item-sources-item-2-end
candidates-item-sources-item-1-selector-kv ::= "\"selector\"" space ":" space candidates-item-sources-item-1-selector
candidates-item-polarity ::= ("\"affirmed\"" | "\"denied\"") space
string ::= "\"" char* "\"" space
candidates-item-kind ::= ("\"fact\"" | "\"world_change\"" | "\"error_correction\"" | "\"decision\"" | "\"consideration\"" | "\"intention\"" | "\"additional_support\"") space
candidates-item-sources-item-2-selector-kv ::= "\"selector\"" space ":" space candidates-item-sources-item-2-selector
candidates-item-effect ::= ("\"assert\"" | "\"correct\"" | "\"attach_support\"") space
candidates-item-context-kv ::= "\"context\"" space ":" space candidates-item-context
space ::= | " " | "\n" [ \t]{0,20}
candidates-item-object-kind ::= ("\"text\"" | "\"entity\"" | "\"date\"") space
candidates-item-sources-item-0 ::= "{" space candidates-item-sources-item-0-ref-kv "}" space
candidates-item-sources-item ::= candidates-item-sources-item-0 | candidates-item-sources-item-1 | candidates-item-sources-item-2
window-id-kv ::= "\"window_id\"" space ":" space string
