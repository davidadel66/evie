{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-result.schema.json",
  "title": "Story review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "candidate",
    "findings",
    "backlog_candidates",
    "acceptance_coverage",
    "checks",
    "lenses",
    "residual_risks",
    "summary"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "DECISION_REQUIRED",
        "CHANGES_REQUIRED",
        "REVIEW_INCOMPLETE",
        "READY_FOR_HUMAN_REVIEW"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_ref",
        "pr_url",
        "worktree",
        "base_commit",
        "head_commit",
        "clean"
      ],
      "properties": {
        "story_ref": { "type": "string" },
        "pr_url": { "type": "string" },
        "worktree": { "type": "string" },
        "base_commit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        },
        "clean": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "backlog_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/backlogCandidate" }
    },
    "acceptance_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "code_evidence",
          "test_evidence"
        ],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["COVERED", "GAP", "UNVERIFIED"] },
          "code_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "test_evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exit_code", "evidence"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "SKIPPED"] },
          "exit_code": {
            "oneOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "correctness", "maintainability"],
      "properties": {
        "contract": { "$ref": "#/$defs/lensResult" },
        "correctness": { "$ref": "#/$defs/lensResult" },
        "maintainability": { "$ref": "#/$defs/lensResult" }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "READY_FOR_HUMAN_REVIEW" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "story_ref": { "minLength": 1 },
              "worktree": { "minLength": 1 },
              "base_commit": { "pattern": "^[0-9a-f]{40}$" },
              "head_commit": { "pattern": "^[0-9a-f]{40}$" },
              "clean": { "const": true }
            }
          },
          "findings": { "maxItems": 0 },
          "acceptance_coverage": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": { "const": "COVERED" },
                "code_evidence": { "minItems": 1 },
                "test_evidence": { "minItems": 1 }
              }
            }
          },
          "checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": { "const": "PASSED" },
                "exit_code": { "const": 0 },
                "evidence": { "minLength": 1 }
              }
            }
          },
          "lenses": {
            "properties": {
              "contract": {
                "properties": {
                  "status": { "const": "COMPLETED" }
                }
              },
              "correctness": {
                "properties": {
                  "status": { "const": "COMPLETED" }
                }
              },
              "maintainability": {
                "properties": {
                  "status": { "const": "COMPLETED" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "backlogCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "evidence",
        "impact",
        "why_deferred",
        "verification"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "why_deferred": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "kind",
        "title",
        "file",
        "line",
        "evidence",
        "impact",
        "test_gap",
        "required_change"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "kind": {
          "enum": [
            "CONTRACT",
            "CORRECTNESS",
            "SECURITY",
            "PERSISTENCE",
            "CONCURRENCY",
            "TEST",
            "MAINTAINABILITY"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "file": { "type": "string" },
        "line": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "test_gap": { "type": "string", "minLength": 1 },
        "required_change": { "type": "string", "minLength": 1 }
      }
    },
    "lensResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["COMPLETED", "SKIPPED"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
