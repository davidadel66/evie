{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lens-result.schema.json",
  "title": "Story review lens result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lens",
    "status",
    "candidate",
    "findings",
    "backlog_candidates",
    "observations",
    "residual_risks",
    "summary"
  ],
  "properties": {
    "lens": {
      "enum": ["CONTRACT", "CORRECTNESS", "MAINTAINABILITY"]
    },
    "status": { "enum": ["COMPLETED", "SKIPPED"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "head_commit"],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "review-result.schema.json#/$defs/finding"
      }
    },
    "backlog_candidates": {
      "type": "array",
      "items": {
        "$ref": "review-result.schema.json#/$defs/backlogCandidate"
      }
    },
    "observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SKIPPED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "findings": { "maxItems": 0 },
          "backlog_candidates": { "maxItems": 0 }
        }
      }
    }
  ]
}
