{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-result.schema.json",
  "title": "Story delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "story",
    "candidate",
    "delivery",
    "final_review",
    "review_history",
    "blocker",
    "known_gaps",
    "residual_risks",
    "best_files",
    "summary"
  ],
  "properties": {
    "status": {
      "enum": ["DELIVERED", "DECISION_REQUIRED", "DELIVERY_INCOMPLETE"]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "title"],
      "properties": {
        "ref": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree",
        "branch",
        "base_commit",
        "head_commit",
        "clean"
      ],
      "properties": {
        "worktree": { "type": "string" },
        "branch": { "type": "string" },
        "base_commit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        },
        "clean": { "type": "boolean" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_url",
        "pr_state",
        "remote",
        "base_branch",
        "head_branch",
        "head_commit"
      ],
      "properties": {
        "pr_url": { "type": "string" },
        "pr_state": { "enum": ["DRAFT", "OPEN", "NONE"] },
        "remote": { "type": "string" },
        "base_branch": { "type": "string" },
        "head_branch": { "type": "string" },
        "head_commit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        }
      }
    },
    "final_review": {
      "oneOf": [
        {
          "$ref": "../../review-story/references/review-result.schema.json"
        },
        { "type": "null" }
      ]
    },
    "review_history": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pass",
          "head_commit",
          "verdict",
          "finding_ids",
          "repair_head_commit",
          "finding_dispositions"
        ],
        "properties": {
          "pass": { "type": "integer", "minimum": 1, "maximum": 3 },
          "head_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "verdict": {
            "enum": [
              "DECISION_REQUIRED",
              "CHANGES_REQUIRED",
              "REVIEW_INCOMPLETE",
              "READY_FOR_HUMAN_REVIEW"
            ]
          },
          "finding_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "repair_head_commit": {
            "type": "string",
            "pattern": "^$|^[0-9a-f]{40}$"
          },
          "finding_dispositions": {
            "type": "array",
            "items": { "$ref": "#/$defs/findingDisposition" }
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "reason", "continuation_commands"],
      "properties": {
        "phase": {
          "enum": [
            "NONE",
            "IMPLEMENTATION",
            "REVIEW",
            "REPAIR",
            "DELIVERY",
            "DECISION"
          ]
        },
        "reason": { "type": "string" },
        "continuation_commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "best_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "DELIVERED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "story": {
            "properties": {
              "ref": { "minLength": 1 },
              "title": { "minLength": 1 }
            }
          },
          "candidate": {
            "properties": {
              "worktree": { "minLength": 1 },
              "branch": { "minLength": 1 },
              "base_commit": { "pattern": "^[0-9a-f]{40}$" },
              "head_commit": { "pattern": "^[0-9a-f]{40}$" },
              "clean": { "const": true }
            }
          },
          "delivery": {
            "properties": {
              "pr_url": { "minLength": 1 },
              "pr_state": { "enum": ["DRAFT", "OPEN"] },
              "remote": { "minLength": 1 },
              "base_branch": { "minLength": 1 },
              "head_branch": { "minLength": 1 },
              "head_commit": { "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "final_review": {
            "type": "object",
            "properties": {
              "verdict": { "const": "READY_FOR_HUMAN_REVIEW" }
            }
          },
          "review_history": { "minItems": 1 },
          "blocker": {
            "properties": {
              "phase": { "const": "NONE" },
              "reason": { "maxLength": 0 },
              "continuation_commands": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "DECISION_REQUIRED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocker": {
            "properties": {
              "phase": { "const": "DECISION" },
              "reason": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "DELIVERY_INCOMPLETE" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocker": {
            "properties": {
              "phase": { "not": { "const": "NONE" } },
              "reason": { "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "findingDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ADDRESSED", "DISPUTED", "BLOCKED"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
