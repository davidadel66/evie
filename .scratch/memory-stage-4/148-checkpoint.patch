+}
+export const diagnosticState: DiagnosticsState = { scope: "global", session: "closed-session", view: "jobs", generation: "", generations: ["generation-1", "generation-2"], scopesBusy: false, busy: false, problem: "", scopes: { scopes: [{ scope_key: "global", kind: "global", label: "Global memory" }], next_cursor: "more-scopes", indexing: false }, sessions: { session_ids: ["closed-session"], next_cursor: "more-sessions" }, page: diagnosticPage };
