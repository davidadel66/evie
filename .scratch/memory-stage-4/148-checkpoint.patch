+ jobs: [{ job_id: "earlier-gap", generation_id: "generation-1", session_id: "closed-session", first_sequence: 1, last_sequence: 3, state: "failed", reason: "attempts_exhausted", attempts: 5, lane: "new", recovery: "select a new generation", queued_at_unix_ms: 1000, published_at_unix_ms: null, selected_new_events: 2, completed_new_events: 0, candidate_freshness_nanos: null, publication_nanos: null, measurements: [{ attempt: 5, fence: 7, claimed_at_unix_ms: 2000, queue_wait_nanos: 1000, inference_nanos: null, validation_nanos: null, database_completion_nanos: null, observed_outcome: "incomplete" }] }, { job_id: "later-success", generation_id: "generation-2", session_id: "closed-session", first_sequence: 4, last_sequence: 7, state: "completed_candidates", attempts: 1, lane: "new", queued_at_unix_ms: 2000, published_at_unix_ms: 3000, selected_new_events: 1, completed_new_events: 1, candidate_freshness_nanos: null, publication_nanos: null, measurements: [] }],
+ candidates: [], activations: [], history: [], selection: [], foreground: [], selections: [], live_roots: [],
