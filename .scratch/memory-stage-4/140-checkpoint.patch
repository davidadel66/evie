+	replay, err := f.store.VerifySemanticProjection(ctx)
+	if err != nil || !replay.Valid {
+		t.Fatalf("scope replay %+v %v", replay, err)
+	}
+	authority, err := f.store.LocalOwnerReviewContext(ctx, "workspace:"+string(workspaceA.ID))
+	if err != nil {
+		t.Fatal(err)
