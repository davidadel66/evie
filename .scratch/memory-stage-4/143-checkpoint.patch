+	if replay, err := f.store.VerifySemanticProjection(ctx); err != nil || !replay.Valid {
+		t.Fatalf("replay %+v %v", replay, err)
+	}
+	if extractor.calls.Load() != 1 {
+		t.Fatal("replay invoked extraction")
