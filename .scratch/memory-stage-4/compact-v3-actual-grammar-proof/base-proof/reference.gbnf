root ::= alternative-0 | alternative-1 | alternative-2
alternative-2 ::= "{" space alternative-2-end-kv "," space alternative-2-ref-kv "," space alternative-2-selector-kv "," space alternative-2-start-kv "}" space
alternative-2-start ::= ([0] | [1-9] [0-9]{0,15}) space
alternative-2-selector-kv ::= "\"selector\"" space ":" space alternative-2-selector
alternative-2-selector ::= ("\"range\"") space
alternative-2-ref-kv ::= "\"ref\"" space ":" space string
alternative-1 ::= "{" space alternative-1-ref-kv "," space alternative-1-selector-kv "}" space
alternative-0 ::= "{" space alternative-0-ref-kv "}" space
alternative-2-end ::= ([1-9] [0-9]{0,15}) space
alternative-1-selector-kv ::= "\"selector\"" space ":" space alternative-1-selector
alternative-2-start-kv ::= "\"start\"" space ":" space alternative-2-start
space ::= | " " | "\n" [ \t]{0,20}
alternative-1-selector ::= ("\"whole\"" | "\"date\"") space
alternative-0-ref-kv ::= "\"ref\"" space ":" space string
alternative-2-end-kv ::= "\"end\"" space ":" space alternative-2-end
alternative-1-ref-kv ::= "\"ref\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
string ::= "\"" char* "\"" space
