+	compiled, err := f.store.CompileCandidateUnit(ctx, f.session.ScopeContext(), selection, identityGeneration(), &scriptedCompiler{run: func(_ context.Context, r memory.CompilerRequest) (eviedb.CompilerExtraction, error) {
