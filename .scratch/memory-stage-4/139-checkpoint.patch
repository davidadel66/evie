+func scopedHistoryRange(f *workerFixture, first, last memory.Event) memory.CompilerHistoryRange {
+	r := historyRange(f, first, last)
+	r.SourceScope = scopeKeyForContext(f.owner)
+	r.Destination = r.SourceScope
+	return r
+}
