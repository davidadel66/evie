+	}
+	wg.Wait()
+	select {
+	case err := <-errs:
+		t.Fatal(err)
+	default:
+	}
+	if n := activationCount(t, f.db, `SELECT COUNT(*) FROM memory_compiler_jobs`); n != 1 {
+		t.Fatal("duplicate interval ownership", n)
+	}
+	if n := activationCount(t, f.db, `SELECT COUNT(*) FROM memory_compiler_history_requests`); n != 2 {
