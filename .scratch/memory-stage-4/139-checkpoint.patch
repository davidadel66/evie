+	close(start)
+	for range 2 {
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	var wg sync.WaitGroup
+	for _, store := range []*Store{f.store, other} {
+		wg.Add(1)
+		go func(store *Store) {
+			defer wg.Done()
+			for range 8 {
