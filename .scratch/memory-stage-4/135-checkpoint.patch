+				for _, name := range []string{"prompt.txt", "output.schema.json", "runtime-manifest.json", "runtime-api-metadata.json", "tokenizer-proof.json", "generator-policy.json"} {
+					b, err := os.ReadFile(filepath.Join(base, name))
+					if err != nil {
