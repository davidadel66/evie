+func objectHash(v any) string {
+	b, _ := json.Marshal(v)
+	return fmt.Sprintf("sha256:%x", sha256.Sum256(b))
+}
+func textHash(v string) string { return fmt.Sprintf("sha256:%x", sha256.Sum256([]byte(v))) }
