+  {item.temporal && <CorrectionLineage correction={item.temporal}/>}
+  {item.candidate.review_state === "unresolved" && <>
+   {item.candidate.proposal.identity && <><p className="text-amber-ink">Additional identity review: explicitly choose an existing identity or create a distinct definition.</p><button className={button} disabled={state.busy || !controller} onClick={() => void controller?.loadIdentityOptions()}>Inspect identity alternatives</button></>}
+   {state.identityOptions && <IdentityForm key={state.identityOptions.options_sha256} item={item} options={state.identityOptions} disabled={state.busy || !controller} onChoose={(choices) => void controller?.chooseIdentity({ candidate: state.identityOptions!.candidate, options_sha256: state.identityOptions!.options_sha256, choices })}/>}
+   {item.candidate.proposal.temporal?.correction && <><p>Choose the exact earlier claim and whether it was wrong or the world changed. Unknown effective times remain unknown.</p><button className={button} disabled={state.busy || !controller} onClick={() => void controller?.loadTemporalOptions()}>Inspect correction alternatives</button></>}
+   {state.temporalOptions && <TemporalForm key={state.temporalOptions.options_sha256} options={state.temporalOptions} disabled={state.busy || !controller} onChoose={(choice) => void controller?.chooseTemporal({ candidate: state.temporalOptions!.candidate, options_sha256: state.temporalOptions!.options_sha256, choice })}/>}
+   <button className={`${button} block`} disabled={state.busy || !controller} onClick={() => setEditing(!editing)}>{editing ? "Close edit draft" : "Edit interpretation"}</button>
+   {editing && <EditForm item={item} disabled={state.busy || !controller} onEdit={(proposal, reason, candidate) => void controller?.edit({ candidate, proposal, reason })}/>}
+  </>}
+  {item.ref.interpretation_revision > 0 && <HistoryForm maximum={item.ref.interpretation_revision} state={state} controller={controller}/>}
+ </section>;
+}
+
+function HistoryForm({ maximum, state, controller }: { maximum: number; state: InboxState; controller?: CandidateInboxController }) {
+ const [kind, setKind] = useState<InterpretationHistory["kind"]>("edit"); const [revision, setRevision] = useState(1);
+ const history = state.history?.kind === kind && state.history.value.revision === revision ? state.history : undefined;
+ const valid = Number.isSafeInteger(revision) && revision >= 1 && revision <= maximum;
+ return <details><summary>Inspect interpretation history</summary><p className="mt-2 text-xs">Edits, identity choices and correction choices share one revision sequence. Select the recorded kind and revision; a number may belong to a different kind.</p><form className="mt-2 space-y-2" onSubmit={(event) => { event.preventDefault(); if (valid) void controller?.loadHistoryRevision(kind, revision); }}><fieldset disabled={state.busy || !controller} className="space-y-2"><label className="block text-xs">History kind<select aria-label="Interpretation history kind" className={input} value={kind} onChange={(event) => { const value = event.target.value; if (value === "edit" || value === "identity" || value === "correction") setKind(value); }}><option value="edit">Owner edit</option><option value="identity">Identity choice</option><option value="correction">Correction choice</option></select></label><label className="block text-xs">Interpretation revision<input aria-label="Interpretation history revision" className={input} type="number" min={1} max={maximum} step={1} value={revision} onChange={(event) => setRevision(Number(event.target.value))}/></label><button className={button} disabled={!valid} type="submit">Load immutable history revision</button></fieldset></form>{history?.kind === "edit" && <EditLineage edit={history.value}/>} {history?.kind === "identity" && <IdentityLineage identity={history.value}/>} {history?.kind === "correction" && <CorrectionLineage correction={history.value}/>}</details>;
