+}
+export function CanonicalDisclosure({ value, title = "Complete canonical disclosure" }: { value: unknown; title?: string }) { return <details className="text-muted-text mt-3 text-xs"><summary>{title}</summary><pre className="whitespace-pre-wrap break-all p-2">{JSON.stringify(value, null, 2)}</pre></details>; }
