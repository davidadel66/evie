+ </form>;
+}
+
+function TemporalForm({ options, disabled, onChoose }: { options: TemporalOptions; disabled: boolean; onChoose: (choice: { old_claim_id: string; mode: string }) => void }) {
+ const [claim, setClaim] = useState(""); const [mode, setMode] = useState("");
+ return <form aria-label="Correction choices" className="border-hair space-y-3 rounded border p-3" onSubmit={(event) => { event.preventDefault(); if (claim && mode) onChoose({ old_claim_id: claim, mode }); }}><fieldset disabled={disabled}><legend>Exact earlier claim</legend>{options.alternatives.map((alt) => <label className="mt-2 block text-xs" key={alt.claim.claim_id}><input type="radio" name="old-claim" checked={claim === alt.claim.claim_id} onChange={() => setClaim(alt.claim.claim_id)}/> {alt.claim.predicate.label}: {alt.claim.polarity} {alt.claim.object.literal?.value ?? alt.claim.object.entity_id} · {alt.state.state} · {alt.claim.claim_id} · valid {alt.claim.valid_time.from ?? "Unknown"} / {alt.claim.valid_time.to ?? "Unknown"}</label>)}</fieldset><fieldset disabled={disabled}><legend>Correction meaning</legend>{options.modes.map((value) => <label className="mt-2 block text-xs" key={value}><input type="radio" name="correction-mode" checked={mode === value} onChange={() => setMode(value)}/> {value === "error" ? "Error: earlier statement was wrong" : value === "changed" ? "Changed: the real-world state changed" : value}</label>)}</fieldset><p>Source-proposed effective time: {options.effective_time ?? "Unknown; a changed correction may require an edited, sourced interpretation or a separate assertion."}</p><button className={button} type="submit" disabled={disabled || !claim || !mode}>Record this correction choice</button></form>;
+}
