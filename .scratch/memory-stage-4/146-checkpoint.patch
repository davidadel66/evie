+}
+export function IdentityLineage({ identity }: { identity: IdentityRevision }) {
+ return <section aria-label="Recorded identity history" className="border-hair mt-4 space-y-2 border-t pt-3"><h4>Recorded identity choice</h4><RevisionAudit revision={identity}/><p className="text-xs">Scope: {identity.options.scope_key} · candidate {identity.options.candidate.candidate_id}</p>{(["subject", "object"] as const).map((field) => {
+  const choice = identity.choices[field]; const alternatives = identity.options[field];
+  return <section key={field}><h5>{field === "subject" ? "Subject" : "Object"} choice</h5><p className="text-xs">{!choice ? "No unresolved identity choice for this field" : choice.create ? "Create a distinct Entity" : `Reuse Entity ${choice.entity_id}`}</p>{alternatives.length > 0 && <details><summary>Recorded {field} alternatives</summary>{alternatives.map((alternative) => <div key={alternative.entity.entity_id} className="mt-2 text-xs"><p>{alternative.entity.canonical_name} · {alternative.entity.entity_type} · {alternative.entity.scope_key} · {alternative.entity.entity_id}{choice && !choice.create && choice.entity_id === alternative.entity.entity_id ? " · Chosen" : ""}</p><p>Aliases: {alternative.aliases.map((alias) => `${alias.value} (${alias.alias_id})`).join(", ") || "None"}</p>{alternative.context.map((claim) => <p key={claim.claim_id}>Known context at this revision: {claim.predicate.label} · {claim.polarity} · {claim.object.literal?.value ?? claim.object.entity_id} · claim {claim.claim_id} · valid {claim.valid_time.from ?? "Unknown"} / {claim.valid_time.to ?? "Unknown"}</p>)}</div>)}</details>}</section>;
+ })}<section><h5>Predicate choice</h5><p className="text-xs">{!identity.choices.predicate ? "No unresolved Predicate choice" : identity.choices.predicate.create ? "Create the sourced global Predicate definition" : `Reuse Predicate ${identity.choices.predicate.predicate_id}`}</p>{identity.options.predicates.length > 0 && <details><summary>Recorded Predicate alternatives</summary>{identity.options.predicates.map((predicate) => <p className="text-xs" key={predicate.predicate_id}>{predicate.label} · {predicate.token} v{predicate.version} · {predicate.object_constraint} · {predicate.cardinality} · {predicate.predicate_id}</p>)}</details>}</section><CanonicalDisclosure value={identity} title="Complete immutable identity revision and reviewed alternatives"/></section>;
+}
+export function CorrectionLineage({ correction }: { correction: TemporalRevision }) {
