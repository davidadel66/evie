+ return <>{effect.identity && <section className="mt-4"><h4>Explicit identity decisions</h4><p className="text-xs">Interpretation {effect.identity.revision.revision}; alternatives remain retained. Reusing a name never merges distinct Entities.</p>{effect.identity.aliases.map((alias) => <p className="mt-2 text-xs" key={alias.alias_id}>{alias.create ? "Create Alias" : "Reuse Alias"}: {alias.value} → Entity {alias.entity_id}; Alias {alias.alias_id}; scope {alias.scope_key}; source {alias.source_event_id}</p>)}<CanonicalDisclosure value={effect.identity.revision} title="Chosen identities and all reviewed alternatives"/></section>}{effect.correction && <section aria-label="Correction effects" className="text-amber-ink mt-4"><h4>Correction: {effect.correction.mode === "error" ? "Earlier statement was an error" : "Real-world state changed"}</h4><p>Old claim {effect.correction.old_claim.claim_id}: {effect.correction.old_claim.polarity} {effect.correction.old_claim.object.literal?.value ?? effect.correction.old_claim.object.entity_id}</p><p>Lifecycle: {effect.correction.old_state.state} → {effect.correction.transition.state}</p><p>Effective time: {effect.correction.effective_time ?? "Unknown"}</p><p>Old validity before: {effect.correction.valid_time_effect.old_before.from ?? "Unknown"} / {effect.correction.valid_time_effect.old_before.to ?? "Unknown"}</p><p>Old validity after: {effect.correction.valid_time_effect.old_after.from ?? "Unknown"} / {effect.correction.valid_time_effect.old_after.to ?? "Unknown"}</p><p>Replacement validity: {effect.correction.valid_time_effect.replacement.from ?? "Unknown"} / {effect.correction.valid_time_effect.replacement.to ?? "Unknown"}</p></section>}{effect.claims.map((claim) => <ClaimEffect key={claim.claim.claim_id} effect={claim}/>)}</>;
+}
+export function DependencyDisclosure({ dependencies }: { dependencies: import("../api/candidateReview").ReviewDependency[] }) { return <section className="mt-3"><h4>Explicit dependency closure</h4>{dependencies.length ? <ul>{dependencies.map((dep,i) => <li className="mt-1 break-all text-xs" key={i}>{dep.candidate_id} {dep.field} uses the exact {dep.from_field} created by {dep.from_candidate_id}.</li>)}</ul> : <p className="text-xs">No proposed identities are shared by dependency binding in this group.</p>}</section>; }
